# Copie para .env e preencha. O .env nunca vai para o Git.
# Provedor: groq (padrão) | ollama | openai  (qualquer API compatível com OpenAI via LLM_BASE_URL)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
# Opcionais
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=...
# LLM_API_KEY=...
# "Agora" fixo para reproduzir cenários (AAAA-MM-DD HH:MM, fuso America/Campo_Grande)
# EMPORIO_NOW=2026-03-23 10:30
